<%- include('../partials/head') %>

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <form method="get" action="/admin/categories" class="flex flex-wrap items-center gap-2">
    <input type="hidden" name="view" value="tree" />
    <input type="text" name="q" value="<%= q %>" placeholder="Search name, slug…"
      class="h-10 w-56 rounded-lg border border-slate-300 px-3 text-sm" />
    <select name="type" onchange="this.form.submit()" class="h-10 rounded-lg border border-slate-300 px-3 text-sm">
      <option value="" <%= typeFilter === '' ? 'selected' : '' %>>All types</option>
      <option value="category" <%= typeFilter === 'category' ? 'selected' : '' %>>Category</option>
      <option value="subcategory" <%= typeFilter === 'subcategory' ? 'selected' : '' %>>Subcategory</option>
      <option value="animals" <%= typeFilter === 'animals' ? 'selected' : '' %>>Animals (types &amp; breeds)</option>
    </select>
    <button class="h-10 rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700">Search</button>
  </form>
  <div class="flex items-center gap-3">
    <div class="flex rounded-lg border border-slate-200 overflow-hidden">
      <a href="/admin/categories?view=list<%= typeFilter ? '&type=' + typeFilter : '' %><%= q ? '&q=' + q : '' %>" class="px-3 py-2 text-xs font-semibold bg-white text-slate-600 hover:bg-slate-50">List View</a>
      <a href="/admin/categories?view=tree<%= typeFilter ? '&type=' + typeFilter : '' %><%= q ? '&q=' + q : '' %>" class="px-3 py-2 text-xs font-semibold bg-emerald-600 text-white">Tree View</a>
    </div>
    <% if (animalsView) { %>
      <a href="/admin/categories/animal-types/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ Add Animal Type</a>
      <a href="/admin/categories/animal-breeds/new" class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">+ Add Breed</a>
    <% } else { %>
      <a href="/admin/categories/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ Add Category</a>
      <a href="/admin/categories/import" class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">Import Excel</a>
    <% } %>
  </div>
</div>

<div class="mb-3 flex items-center gap-2">
  <button onclick="document.querySelectorAll('.tree-children').forEach(el => el.classList.remove('hidden')); document.querySelectorAll('.tree-toggle').forEach(el => el.textContent = '−')"
    class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Expand All</button>
  <button onclick="document.querySelectorAll('.tree-children').forEach(el => el.classList.add('hidden')); document.querySelectorAll('.tree-toggle').forEach(el => el.textContent = '+')"
    class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Collapse All</button>
</div>

<div class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
  <div class="divide-y divide-slate-50">
    <% if (animalsView) { %>
      <%# Animal taxonomy: animal_types -> animal_breeds, separate tables %>
      <% animalTypes.forEach(t => { %>
        <div class="flex items-center gap-2 px-4 py-2.5 hover:bg-slate-50">
          <% if (t.breeds && t.breeds.length) { %>
            <button onclick="const ch = document.getElementById('atype-<%= t.id %>'); const tog = document.getElementById('atoggle-<%= t.id %>'); if (ch.classList.contains('hidden')) { ch.classList.remove('hidden'); tog.textContent = '−'; } else { ch.classList.add('hidden'); tog.textContent = '+'; }"
              id="atoggle-<%= t.id %>"
              class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded text-xs font-bold text-slate-500 hover:bg-slate-200 tree-toggle">+</button>
          <% } else { %>
            <span class="w-5 flex-shrink-0"></span>
          <% } %>
          <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-xs font-bold text-emerald-600 ring-1 ring-emerald-100"><%= t.name.charAt(0).toUpperCase() %></div>
          <span class="flex-1 font-medium text-slate-800">
            <%= t.name %>
            <% if (t.nameHi) { %><span class="text-slate-500">(<%= t.nameHi %>)</span><% } %>
          </span>
          <span class="font-mono text-xs text-slate-400"><%= t.code %></span>
          <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Type · <%= (t.breeds || []).length %> breeds</span>
          <% if (t.isActive) { %>
            <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span>
          <% } else { %>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">Inactive</span>
          <% } %>
          <div class="flex items-center gap-1">
            <a href="/admin/categories/animal-types/<%= t.id %>/edit" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
            <a href="/admin/categories/animal-breeds/new?typeId=<%= t.id %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">+ Breed</a>
            <form method="post" action="/admin/categories/animal-types/<%= t.id %>/toggle-active" class="inline">
              <button class="rounded-lg border px-2.5 py-1 text-xs font-semibold <%= t.isActive ? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>">
                <%= t.isActive ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
          </div>
        </div>
        <% if (t.breeds && t.breeds.length) { %>
          <div id="atype-<%= t.id %>" class="tree-children hidden">
            <% t.breeds.forEach(b => { %>
              <div class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50" style="padding-left: 44px">
                <span class="w-5 flex-shrink-0"></span>
                <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-xs font-bold text-indigo-600 ring-1 ring-indigo-100"><%= b.name.charAt(0).toUpperCase() %></div>
                <span class="flex-1 font-medium text-slate-800">
                  <%= b.name %>
                  <% if (b.nameHi) { %><span class="text-slate-500">(<%= b.nameHi %>)</span><% } %>
                </span>
                <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">Breed</span>
                <a href="/admin/categories/animal-breeds/<%= b.id %>/edit" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
      <% if (animalTypes.length === 0) { %>
        <div class="px-4 py-10 text-center text-slate-400">No animal types found</div>
      <% } %>
    <% } else { %>
    <% function renderNode(node, depth) { %>
      <div class="flex items-center gap-2 px-4 py-2.5 hover:bg-slate-50" style="padding-left: <%= depth * 28 + 16 %>px">
        <% if (node.hasChildren) { %>
          <button onclick="const ch = document.getElementById('children-<%= node.id %>'); const tog = document.getElementById('toggle-<%= node.id %>'); if (ch.classList.contains('hidden')) { ch.classList.remove('hidden'); tog.textContent = '−'; } else { ch.classList.add('hidden'); tog.textContent = '+'; }"
            id="toggle-<%= node.id %>"
            class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded text-xs font-bold text-slate-500 hover:bg-slate-200 tree-toggle">+</button>
        <% } else { %>
          <span class="w-5 flex-shrink-0"></span>
        <% } %>
        <% if (node.icon) { %>
          <img src="<%= node.icon %>" alt="<%= node.name %>" class="h-7 w-7 flex-shrink-0 rounded-lg object-cover ring-1 ring-slate-200" />
        <% } else { %>
          <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-xs font-bold text-emerald-600 ring-1 ring-emerald-100"><%= node.name.charAt(0).toUpperCase() %></div>
        <% } %>
        <span class="flex-1 font-medium text-slate-800"><%= node.name %></span>
        <span class="font-mono text-xs text-slate-400"><%= node.slug %></span>
        <% if (node._animal) { %>
          <span class="rounded-full bg-purple-50 px-2 py-0.5 text-xs font-semibold text-purple-700"><%= node._animal === 'root' ? 'Animal Group' : node._animal === 'type' ? 'Animal Type' : 'Breed' %></span>
        <% } else { %>
          <span class="rounded-full <%= node.type === 'subcategory' ? 'bg-indigo-50 text-indigo-700' : 'bg-emerald-50 text-emerald-700' %> px-2 py-0.5 text-xs font-semibold"><%= node.type === 'subcategory' ? 'Subcategory' : 'Category' %></span>
        <% } %>
        <% if (node.isActive) { %>
          <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">Active</span>
        <% } else { %>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">Inactive</span>
        <% } %>
        <div class="flex items-center gap-1">
          <% if (node._animal === 'root') { %>
            <a href="/admin/categories/animal-types/new" class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">+ Animal Type</a>
          <% } else if (node._animal === 'type') { %>
            <a href="/admin/categories/animal-types/<%= node.animalId %>/edit" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
            <a href="/admin/categories/animal-breeds/new?typeId=<%= node.animalId %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">+ Breed</a>
            <form method="post" action="/admin/categories/animal-types/<%= node.animalId %>/toggle-active" class="inline">
              <button class="rounded-lg border px-2.5 py-1 text-xs font-semibold <%= node.isActive ? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>">
                <%= node.isActive ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
          <% } else if (node._animal === 'breed') { %>
            <a href="/admin/categories/animal-breeds/<%= node.animalId %>/edit" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
          <% } else { %>
            <a href="/admin/categories/<%= node.id %>/view" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">View</a>
            <a href="/admin/categories/<%= node.id %>/edit?returnTo=<%= encodeURIComponent('?view=tree' + (typeFilter ? '&type=' + encodeURIComponent(typeFilter) : '') + (q ? '&q=' + encodeURIComponent(q) : '') + (isActiveFilter ? '&isActive=' + isActiveFilter : '')) %>" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
            <a href="/admin/categories/new?parentId=<%= node.id %>&type=<%= node.type %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">+ Child</a>
          <% } %>
        </div>
      </div>
      <% if (node.hasChildren) { %>
        <div id="children-<%= node.id %>" class="tree-children hidden">
          <% node.children.forEach(child => renderNode(child, depth + 1)) %>
        </div>
      <% } %>
    <% } %>
    <% tree.forEach(node => renderNode(node, 0)) %>
    <% if (tree.length === 0) { %>
      <div class="px-4 py-10 text-center text-slate-400">No categories found</div>
    <% } %>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
