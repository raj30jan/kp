<%- include('../partials/head') %>

<div class="mx-auto max-w-2xl space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex flex-wrap items-center gap-1 text-sm text-slate-500">
    <a href="/admin/categories" class="hover:text-slate-700">Categories</a>
    <% breadcrumb.forEach(b => { %>
      <span>/</span>
      <% if (b.id === category.id) { %>
        <span class="font-semibold text-slate-800"><%= b.name %></span>
      <% } else { %>
        <a href="/admin/categories/<%= b.id %>/view" class="hover:text-slate-700"><%= b.name %></a>
      <% } %>
    <% }) %>
  </nav>

  <!-- Category details -->
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
    <div class="flex items-start justify-between">
      <div class="flex items-center gap-3">
        <% if (category.icon) { %>
          <img src="<%= category.icon %>" alt="<%= category.name %>" class="h-16 w-16 rounded-xl object-cover ring-1 ring-slate-200" />
        <% } else { %>
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-emerald-50 text-xl font-bold text-emerald-600 ring-1 ring-emerald-100"><%= category.name.charAt(0).toUpperCase() %></div>
        <% } %>
        <div>
          <h2 class="text-xl font-bold text-slate-900"><%= category.name %></h2>
          <p class="mt-1 font-mono text-xs text-slate-400"><%= category.slug %></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="rounded-full <%= category.type === 'subcategory' ? 'bg-indigo-50 text-indigo-700' : 'bg-emerald-50 text-emerald-700' %> px-2.5 py-1 text-xs font-semibold"><%= category.type === 'subcategory' ? 'Subcategory' : 'Category' %></span>
        <% if (category.isActive) { %>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Active</span>
        <% } else { %>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Inactive</span>
        <% } %>
      </div>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Level</dt>
        <dd class="text-slate-700"><%= category.level %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Leaf?</dt>
        <dd class="text-slate-700"><%= category.isLeaf ? 'Yes' : 'No' %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Display Order</dt>
        <dd class="text-slate-700"><%= category.displayOrder %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Icon</dt>
        <dd class="text-slate-700">
          <% if (category.icon) { %>
            <img src="<%= category.icon %>" alt="icon" class="mt-1 h-10 w-10 rounded-lg object-cover ring-1 ring-slate-200" />
          <% } else { %>
            —
          <% } %>
        </dd>
      </div>
      <div class="col-span-2">
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Path</dt>
        <dd class="font-mono text-xs text-slate-500"><%= category.path || '(root)' %></dd>
      </div>
      <% if (category.description) { %>
        <div class="col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Description</dt>
          <dd class="text-slate-700"><%= category.description %></dd>
        </div>
      <% } %>
    </dl>

    <div class="mt-6 flex gap-2">
      <a href="/admin/categories/<%= category.id %>/edit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Edit</a>
      <a href="/admin/categories/new?parentId=<%= category.id %>&type=<%= category.type %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">+ Add Child</a>
      <form method="post" action="/admin/categories/<%= category.id %>/delete" onsubmit="return confirm('Delete this category and ALL its descendants?')" class="inline">
        <button class="rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-100">Delete</button>
      </form>
    </div>
  </div>

  <!-- Icon upload -->
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
    <h3 class="mb-4 text-sm font-bold text-slate-800">Category Icon Image</h3>
    <div class="flex items-start gap-4">
      <div>
        <% if (category.icon) { %>
          <img src="<%= category.icon %>" alt="icon" class="h-20 w-20 rounded-xl object-cover ring-1 ring-slate-200" id="view-icon-preview" />
        <% } else { %>
          <div class="flex h-20 w-20 items-center justify-center rounded-xl bg-emerald-50 text-2xl font-bold text-emerald-600 ring-1 ring-emerald-100" id="view-icon-preview"><%= category.name.charAt(0).toUpperCase() %></div>
        <% } %>
      </div>
      <form method="post" action="/admin/categories/<%= category.id %>/upload-icon" enctype="multipart/form-data" class="flex-1">
        <label class="mb-1 block text-sm font-medium text-slate-700">Upload / Change Icon</label>
        <input type="file" name="iconImage" accept="image/png,image/jpeg,image/webp,image/svg+xml" required
          onchange="if(this.files[0]){var p=document.getElementById('view-icon-preview');var img=document.createElement('img');img.src=URL.createObjectURL(this.files[0]);img.alt='preview';img.className='h-20 w-20 rounded-xl object-cover ring-1 ring-slate-200';img.id='view-icon-preview';p.parentNode.replaceChild(img,p);}"
          class="block w-full text-sm text-slate-500 file:mr-4 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-emerald-700 hover:file:bg-emerald-100" />
        <p class="mt-1 text-xs text-slate-400">PNG, JPG, WebP, SVG. Max 2MB.</p>
        <button type="submit" class="mt-3 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Upload Icon</button>
      </form>
    </div>
  </div>

  <!-- Children -->
  <% if (children && children.length) { %>
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
      <h3 class="mb-3 text-sm font-bold text-slate-800">Direct Children (<%= children.length %>)</h3>
      <div class="space-y-1">
        <% children.forEach(child => { %>
          <a href="/admin/categories/<%= child.id %>/view" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-slate-50">
            <span class="font-medium text-slate-700"><%= child.name %></span>
            <span class="text-xs text-slate-400"><%= child.slug %> · <%= child.isLeaf ? 'leaf' : 'has children' %></span>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/foot') %>
