<%- include('../partials/head') %>

<div class="mx-auto max-w-xl rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
  <p class="mb-4 text-sm text-slate-500">Manually grant a plan to a user (e.g. complementary/goodwill access) — bypasses the payment flow.</p>
  <% if (errors) { %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= errors %></div>
  <% } %>

  <form method="post" action="/admin/memberships/subscriptions/new" class="space-y-4">
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">User mobile or email</label>
      <input name="userIdentifier" required value="<%= (form && form.userIdentifier) || '' %>" placeholder="9876543210"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Plan</label>
      <select name="planId" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <% plans.forEach(p => { %>
          <option value="<%= p.id %>" <%= (form && String(form.planId) === String(p.id)) ? 'selected' : '' %>><%= p.name %> (₹<%= p.price %>)</option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Status</label>
      <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <% ['active','pending','expired','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= (form && form.status === s) ? 'selected' : (s === 'active' ? 'selected' : '') %>><%= s %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">End Date (blank = never expires)</label>
      <input type="date" name="endDate" value="<%= (form && form.endDate) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Amount override (₹, blank = plan price)</label>
      <input type="number" step="0.01" name="amount" value="<%= (form && form.amount) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Payment Reference (optional)</label>
      <input name="paymentReference" value="<%= (form && form.paymentReference) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Grant Subscription</button>
      <a href="/admin/memberships" class="text-sm font-medium text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
