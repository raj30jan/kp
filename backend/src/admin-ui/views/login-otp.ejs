<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · KisanPatrika Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-emerald-950 via-emerald-900 to-green-800 flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="mb-8 text-center">
      <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-500 text-2xl font-bold text-emerald-950">K</div>
      <h1 class="text-2xl font-extrabold text-white">KisanPatrika Admin</h1>
      <p class="mt-1 text-sm text-emerald-200">Step 2 of 2 — email verification</p>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow-2xl">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= error %>
        </div>
      <% } %>

      <p class="mb-5 text-sm text-slate-600">
        A 6-digit verification code has been emailed to
        <strong class="text-slate-800"><%= email || 'your registered email' %></strong>.
        Enter it below to finish signing in.
      </p>

      <% if (devOtp) { %>
        <div class="mb-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-mono text-amber-800">
          Dev mode OTP: <strong><%= devOtp %></strong>
        </div>
      <% } %>

      <form method="post" action="/admin/login/otp" class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Verification code</label>
          <input type="text" name="otp" required autofocus inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
            class="h-12 w-full rounded-lg border border-slate-300 px-4 text-center text-lg font-bold tracking-[0.5em] focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-200"
            placeholder="••••••" />
        </div>
        <button type="submit"
          class="h-12 w-full rounded-lg bg-emerald-600 text-sm font-bold text-white transition hover:bg-emerald-700">
          Verify &amp; sign in
        </button>
      </form>

      <div class="mt-4 flex items-center justify-between text-sm">
        <a href="/admin/login" class="text-slate-500 hover:text-slate-700">← Back to login</a>
        <form method="post" action="/admin/login/resend-otp">
          <button type="submit" class="font-semibold text-emerald-700 hover:underline">Resend code</button>
        </form>
      </div>
    </div>
    <p class="mt-6 text-center text-xs text-emerald-300">The code expires in 5 minutes. Never share it with anyone.</p>
  </div>
</body>
</html>
