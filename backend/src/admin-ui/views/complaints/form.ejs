<%- include('../partials/head') %>

<div class="mx-auto max-w-xl rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
  <% if (errors) { %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= errors %></div>
  <% } %>

  <form method="post" action="<%= complaint && complaint.id ? `/admin/complaints/${complaint.id}/edit` : '/admin/complaints/new' %>" class="space-y-4">
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Category</label>
      <select name="category" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        <% ['legal','terms','policy','fraud','other'].forEach(c => { %>
          <option value="<%= c %>" <%= (complaint && complaint.category === c) ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Subject</label>
      <input name="subject" required minlength="3" value="<%= (complaint && complaint.subject) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Description</label>
      <textarea name="description" required minlength="10" rows="4" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><%= (complaint && complaint.description) || '' %></textarea>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Contact Mobile</label>
      <input name="contactMobile" value="<%= (complaint && complaint.contactMobile) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Contact Email</label>
      <input type="email" name="contactEmail" value="<%= (complaint && complaint.contactEmail) || '' %>" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
        <%= complaint && complaint.id ? 'Save Changes' : 'Log Complaint' %>
      </button>
      <a href="/admin/complaints" class="text-sm font-medium text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
