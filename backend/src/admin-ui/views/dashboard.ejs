<%- include('partials/head') %>

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Total Users</p>
    <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= stats.totalUsers %></p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <% Object.entries(stats.usersByRole).forEach(([role, count]) => { %>
        <span class="rounded-full bg-slate-100 px-2 py-1 font-medium text-slate-600"><%= role %>: <%= count %></span>
      <% }) %>
    </div>
  </div>

  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Products</p>
    <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= stats.products.total %></p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-amber-50 px-2 py-1 font-medium text-amber-700">Pending: <%= stats.products.pending %></span>
      <span class="rounded-full bg-emerald-50 px-2 py-1 font-medium text-emerald-700">Active: <%= stats.products.active %></span>
      <span class="rounded-full bg-slate-100 px-2 py-1 font-medium text-slate-600">Expired: <%= stats.products.expired %></span>
      <span class="rounded-full bg-red-50 px-2 py-1 font-medium text-red-700">Rejected: <%= stats.products.rejected %></span>
    </div>
  </div>

  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Complaints</p>
    <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= stats.complaints.total %></p>
    <div class="mt-3 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-amber-50 px-2 py-1 font-medium text-amber-700">Open: <%= stats.complaints.open %></span>
      <span class="rounded-full bg-blue-50 px-2 py-1 font-medium text-blue-700">In review: <%= stats.complaints.in_review %></span>
      <span class="rounded-full bg-emerald-50 px-2 py-1 font-medium text-emerald-700">Resolved: <%= stats.complaints.resolved %></span>
    </div>
  </div>

  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-100">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Active Memberships</p>
    <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= stats.activeSubscriptions %></p>
    <p class="mt-3 text-xs text-slate-500">Paid subscribers with a currently-active plan</p>
  </div>
</div>

<div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3">
  <a href="/admin/products?status=pending" class="rounded-2xl border border-amber-200 bg-amber-50 p-5 transition hover:shadow-md">
    <p class="text-sm font-bold text-amber-800">Review pending listings</p>
    <p class="mt-1 text-xs text-amber-700"><%= stats.products.pending %> awaiting approval</p>
  </a>
  <a href="/admin/complaints?status=open" class="rounded-2xl border border-red-200 bg-red-50 p-5 transition hover:shadow-md">
    <p class="text-sm font-bold text-red-800">Open complaints</p>
    <p class="mt-1 text-xs text-red-700"><%= stats.complaints.open %> need attention</p>
  </a>
  <a href="/admin/accounts" class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:shadow-md">
    <p class="text-sm font-bold text-slate-800">Manage users</p>
    <p class="mt-1 text-xs text-slate-600"><%= stats.totalUsers %> registered accounts</p>
  </a>
</div>

<%- include('partials/foot') %>
