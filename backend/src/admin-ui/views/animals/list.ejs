<%- include('../partials/head') %>
<% const currentQuery = { status: statusFilter, q, page: data.page } %>
<%
function qs(overrides) {
  const merged = Object.assign({}, typeof currentQuery !== 'undefined' ? currentQuery : {}, overrides)
  return Object.entries(merged)
    .filter(([, v]) => v !== '' && v !== undefined && v !== null)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&')
}
function animalMeta(l) {
  const bits = []
  if (l.gender) bits.push(l.gender === 'male' ? 'Male' : 'Female')
  const age = []
  if (l.ageYears != null && l.ageYears !== '') age.push(l.ageYears + 'y')
  if (l.ageMonths != null && l.ageMonths !== '') age.push(l.ageMonths + 'm')
  if (age.length) bits.push(age.join(' '))
  if (l.milkCapacity != null) bits.push(l.milkCapacity + ' L/day')
  if (l.lactationNumber != null) bits.push('Lact ' + l.lactationNumber)
  if (l.isPregnant) bits.push('Pregnant' + (l.monthsPregnant != null ? ' ' + l.monthsPregnant + 'm' : ''))
  return bits.join(' · ')
}
%>

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <form method="get" action="/admin/animals" class="flex flex-wrap items-center gap-2">
    <input type="text" name="q" value="<%= q %>" placeholder="Search title, breed, location, mobile…"
      class="h-10 w-72 rounded-lg border border-slate-300 px-3 text-sm" />
    <select name="status" onchange="this.form.submit()" class="h-10 rounded-lg border border-slate-300 px-3 text-sm">
      <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All statuses</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
      <option value="rejected" <%= statusFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
      <option value="deleted" <%= statusFilter === 'deleted' ? 'selected' : '' %>>Deleted</option>
    </select>
    <button class="h-10 rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700">Search</button>
  </form>
  <p class="text-sm text-slate-500"><%= data.total %> total listings</p>
</div>

<form method="post" action="/admin/animals/bulk" id="bulk-form">
  <div class="mb-3 flex items-center gap-2">
    <select name="action" class="h-9 rounded-lg border border-slate-300 px-2 text-sm">
      <option value="activate">Approve selected</option>
      <option value="reject">Reject selected</option>
      <option value="delete">Delete selected (photos + video removed)</option>
    </select>
    <button type="submit" onclick="return confirm('Apply this action to all selected listings?')"
      class="h-9 rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Apply</button>
  </div>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3"><input type="checkbox" onclick="document.querySelectorAll('.row-check').forEach(c=>c.checked=this.checked)" /></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Photo</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Listing</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Type / Breed</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Price</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Seller Contact</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Status</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Created</th>
          <th class="px-4 py-3 text-right font-semibold text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% data.items.forEach(l => { %>
          <tr>
            <td class="px-4 py-3"><input class="row-check" type="checkbox" name="ids" value="<%= l.id %>" /></td>
            <td class="px-4 py-3">
              <% const thumb = l.images && l.images.length ? (l.images[0].thumbUrl || l.images[0].imageUrl) : null %>
              <% if (thumb) { %>
                <a href="<%= l.images[0].imageUrl %>" target="_blank" rel="noopener">
                  <img src="<%= thumb %>" alt="" class="h-12 w-12 rounded-lg object-cover ring-1 ring-slate-200" />
                </a>
              <% } else { %>
                <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-slate-100 text-xs text-slate-400">—</span>
              <% } %>
              <% if (l.videoUrl) { %><span class="mt-1 inline-block text-[10px] font-semibold text-emerald-600">video</span><% } %>
            </td>
            <td class="px-4 py-3 font-medium text-slate-800">
              <div><%= l.title %></div>
              <div class="mt-0.5 text-xs font-normal text-slate-500"><%= animalMeta(l) %></div>
            </td>
            <td class="px-4 py-3 text-slate-600"><%= l.type ? l.type.name : '' %><%= l.breed ? ' / ' + l.breed.name : '' %></td>
            <td class="px-4 py-3 text-slate-600">₹<%= l.price %><%= l.isNegotiable ? ' <span class="text-xs text-slate-400">nego.</span>' : '' %></td>
            <td class="px-4 py-3 text-slate-600">
              <div><%= l.mobile || '—' %></div>
              <div class="text-xs text-slate-400"><%= [l.district, l.state].filter(Boolean).join(', ') || l.location || '' %></div>
            </td>
            <td class="px-4 py-3">
              <% const badge = { pending: 'bg-amber-50 text-amber-700', active: 'bg-emerald-50 text-emerald-700', rejected: 'bg-red-50 text-red-700', deleted: 'bg-red-100 text-red-800' } %>
              <span class="rounded-full <%= badge[l.status] || 'bg-slate-100 text-slate-600' %> px-2.5 py-1 text-xs font-semibold"><%= l.status %></span>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= new Date(l.createdAt).toLocaleDateString() %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap justify-end gap-1.5">
                <% if (l.status === 'pending' || l.status === 'rejected') { %>
                  <button type="submit" form="activate-<%= l.id %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">Approve</button>
                <% } %>
                <% if (l.status === 'pending' || l.status === 'active') { %>
                  <button type="submit" form="reject-<%= l.id %>" class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:bg-amber-100">Reject</button>
                <% } %>
                <button type="submit" form="delete-<%= l.id %>" onclick="return confirm('DELETE this listing? Photos and video will be permanently removed.')" class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Delete</button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (data.items.length === 0) { %>
          <tr><td colspan="9" class="px-4 py-10 text-center text-slate-400">No listings found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<% data.items.forEach(l => { %>
  <form id="activate-<%= l.id %>" method="post" action="/admin/animals/<%= l.id %>/activate" class="hidden"></form>
  <form id="reject-<%= l.id %>" method="post" action="/admin/animals/<%= l.id %>/reject" class="hidden"></form>
  <form id="delete-<%= l.id %>" method="post" action="/admin/animals/<%= l.id %>/delete" class="hidden"></form>
<% }) %>

<% if (data.total > data.limit) { %>
  <div class="mt-4 flex justify-center gap-2 text-sm">
    <% for (let p = 1; p <= data.pages; p++) { %>
      <a href="?<%= qs({ page: p }) %>"
        class="rounded-lg px-3 py-1.5 <%= p === data.page ? 'bg-emerald-600 text-white' : 'border border-slate-200 text-slate-600 hover:bg-slate-50' %>"><%= p %></a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
