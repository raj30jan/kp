<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · KisanPatrika Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            emerald: { 950: '#022c22' },
          },
        },
      },
    }
  </script>
  <style>
    body { font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="hidden md:flex w-64 flex-col bg-gradient-to-b from-emerald-950 via-emerald-900 to-emerald-800 text-emerald-50">
      <div class="flex items-center gap-2 px-6 py-5 border-b border-emerald-800/60">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 font-bold text-emerald-950">K</div>
        <div>
          <p class="text-sm font-bold leading-tight">KisanPatrika</p>
          <p class="text-[11px] text-emerald-300 leading-tight">Admin Panel</p>
        </div>
      </div>
      <nav class="flex-1 space-y-1 px-3 py-4">
        <%- include('nav', { active: active }) %>
      </nav>
      <div class="border-t border-emerald-800/60 px-4 py-4">
        <p class="text-xs text-emerald-300">Signed in as</p>
        <p class="truncate text-sm font-semibold"><%= adminName %></p>
        <p class="text-[11px] uppercase tracking-wide text-emerald-400"><%= adminUser ? adminUser.role.replace('_',' ') : '' %></p>
        <form method="post" action="/admin/logout" class="mt-3">
          <button type="submit" class="w-full rounded-lg bg-emerald-800/70 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-800">Log out</button>
        </form>
      </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 flex flex-col min-w-0">
      <header class="flex items-center justify-between border-b bg-white px-4 py-3 md:px-8">
        <h1 class="text-lg font-bold text-slate-900"><%= title %></h1>
        <div class="flex items-center gap-3 text-sm text-slate-500">
          <span class="hidden sm:inline">KisanPatrika Backend Admin UI</span>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= adminUser ? adminUser.role.replace('_',' ') : '' %></span>
        </div>
      </header>
      <main class="flex-1 px-4 py-6 md:px-8">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">
            <%= flash %>
          </div>
        <% } %>
