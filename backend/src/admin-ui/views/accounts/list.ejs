<%- include('../partials/head') %>
<% const currentQuery = { role: roleFilter, q, sort, dir, page: data.page } %>
<%
function qs(overrides) {
  const merged = Object.assign({}, typeof currentQuery !== 'undefined' ? currentQuery : {}, overrides)
  return Object.entries(merged)
    .filter(([, v]) => v !== '' && v !== undefined && v !== null)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&')
}
function sortDir(col) {
  return (typeof sort !== 'undefined' && sort === col && dir === 'ASC') ? 'DESC' : 'ASC'
}
function sortIndicator(col) {
  if (typeof sort === 'undefined' || sort !== col) return ''
  return dir === 'ASC' ? ' ▲' : ' ▼'
}
%>

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <form method="get" action="/admin/accounts" class="flex flex-wrap items-center gap-2">
    <input type="text" name="q" value="<%= q %>" placeholder="Search name, mobile, email…"
      class="h-10 w-64 rounded-lg border border-slate-300 px-3 text-sm" />
    <select name="role" onchange="this.form.submit()" class="h-10 rounded-lg border border-slate-300 px-3 text-sm">
      <option value="" <%= roleFilter === '' ? 'selected' : '' %>>All roles</option>
      <option value="user" <%= roleFilter === 'user' ? 'selected' : '' %>>User</option>
      <option value="admin" <%= roleFilter === 'admin' ? 'selected' : '' %>>Admin</option>
      <option value="super_admin" <%= roleFilter === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
    </select>
    <button class="h-10 rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700">Search</button>
  </form>
  <div class="flex items-center gap-3">
    <p class="text-sm text-slate-500"><%= data.total %> total users</p>
    <% if (adminUser.role === 'super_admin') { %>
      <a href="/admin/accounts/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ Add User</a>
    <% } %>
  </div>
</div>

<form method="post" action="/admin/accounts/bulk" id="bulk-form">
  <div class="mb-3 flex items-center gap-2">
    <select name="action" class="h-9 rounded-lg border border-slate-300 px-2 text-sm">
      <option value="activate">Activate selected</option>
      <option value="deactivate">Deactivate selected</option>
      <option value="delete">Delete selected</option>
    </select>
    <button type="submit" onclick="return confirm('Apply this action to all selected users?')"
      class="h-9 rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Apply</button>
  </div>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3"><input type="checkbox" onclick="document.querySelectorAll('.row-check').forEach(c=>c.checked=this.checked)" /></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'displayName', dir: sortDir('displayName') }) %>">Name<%= sortIndicator('displayName') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Contact</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'role', dir: sortDir('role') }) %>">Role<%= sortIndicator('role') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'isActive', dir: sortDir('isActive') }) %>">Status<%= sortIndicator('isActive') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Free listings/contacts used</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'createdAt', dir: sortDir('createdAt') }) %>">Joined<%= sortIndicator('createdAt') %></a></th>
          <th class="px-4 py-3 text-right font-semibold text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% data.users.forEach(u => { %>
          <tr>
            <td class="px-4 py-3"><input class="row-check" type="checkbox" name="ids" value="<%= u.id %>" /></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= u.displayName || '—' %></td>
            <td class="px-4 py-3 text-slate-600">
              <div><%= u.mobile || '—' %></div>
              <div class="text-xs text-slate-400"><%= u.email || '' %></div>
            </td>
            <td class="px-4 py-3">
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700"><%= u.role %></span>
            </td>
            <td class="px-4 py-3">
              <% if (u.isActive) { %>
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Active</span>
              <% } else { %>
                <span class="rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">Deactivated</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= u.freeListingsUsed %> / <%= u.freeContactsUsed %></td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= new Date(u.createdAt).toLocaleDateString() %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap justify-end gap-1.5">
                <a href="/admin/accounts/<%= u.id %>/edit" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
                <button type="submit" form="toggle-<%= u.id %>" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">
                  <%= u.isActive ? 'Deactivate' : 'Activate' %>
                </button>
                <% if (adminUser.role === 'super_admin') { %>
                  <button type="submit" form="delete-<%= u.id %>" onclick="return confirm('Delete this user?')" class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Delete</button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (data.users.length === 0) { %>
          <tr><td colspan="8" class="px-4 py-10 text-center text-slate-400">No users found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<% data.users.forEach(u => { %>
  <form id="toggle-<%= u.id %>" method="post" action="/admin/accounts/<%= u.id %>/toggle-active" class="hidden"></form>
  <form id="delete-<%= u.id %>" method="post" action="/admin/accounts/<%= u.id %>/delete" class="hidden"></form>
<% }) %>

<% if (data.total > data.limit) { %>
  <div class="mt-4 flex justify-center gap-2 text-sm">
    <% for (let p = 1; p <= data.pages; p++) { %>
      <a href="?<%= qs({ page: p }) %>"
        class="rounded-lg px-3 py-1.5 <%= p === data.page ? 'bg-emerald-600 text-white' : 'border border-slate-200 text-slate-600 hover:bg-slate-50' %>"><%= p %></a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
