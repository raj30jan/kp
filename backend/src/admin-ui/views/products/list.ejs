<%- include('../partials/head') %>
<% const currentQuery = { status: statusFilter, q, sort, dir, page: data.page } %>
<%
function qs(overrides) {
  const merged = Object.assign({}, typeof currentQuery !== 'undefined' ? currentQuery : {}, overrides)
  return Object.entries(merged)
    .filter(([, v]) => v !== '' && v !== undefined && v !== null)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&')
}
function sortDir(col) {
  return (typeof sort !== 'undefined' && sort === col && dir === 'ASC') ? 'DESC' : 'ASC'
}
function sortIndicator(col) {
  if (typeof sort === 'undefined' || sort !== col) return ''
  return dir === 'ASC' ? ' ▲' : ' ▼'
}
%>

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <form method="get" action="/admin/products" class="flex flex-wrap items-center gap-2">
    <input type="text" name="q" value="<%= q %>" placeholder="Search title, category, location…"
      class="h-10 w-64 rounded-lg border border-slate-300 px-3 text-sm" />
    <select name="status" onchange="this.form.submit()" class="h-10 rounded-lg border border-slate-300 px-3 text-sm">
      <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All statuses</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="active" <%= statusFilter === 'active' ? 'selected' : '' %>>Active</option>
      <option value="expired" <%= statusFilter === 'expired' ? 'selected' : '' %>>Expired</option>
      <option value="rejected" <%= statusFilter === 'rejected' ? 'selected' : '' %>>Rejected</option>
      <option value="deleted" <%= statusFilter === 'deleted' ? 'selected' : '' %>>Deleted</option>
    </select>
    <button class="h-10 rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700">Search</button>
  </form>
  <div class="flex items-center gap-3">
    <p class="text-sm text-slate-500"><%= data.total %> total listings</p>
    <a href="/admin/products/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ Add Listing</a>
  </div>
</div>

<form method="post" action="/admin/products/bulk" id="bulk-form">
  <div class="mb-3 flex items-center gap-2">
    <select name="action" class="h-9 rounded-lg border border-slate-300 px-2 text-sm">
      <option value="activate">Approve selected</option>
      <option value="reject">Reject selected</option>
      <option value="delete">Delete selected</option>
    </select>
    <button type="submit" onclick="return confirm('Apply this action to all selected listings?')"
      class="h-9 rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Apply</button>
  </div>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3"><input type="checkbox" onclick="document.querySelectorAll('.row-check').forEach(c=>c.checked=this.checked)" /></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'title', dir: sortDir('title') }) %>">Title<%= sortIndicator('title') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Category</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'price', dir: sortDir('price') }) %>">Price<%= sortIndicator('price') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Seller Contact</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'status', dir: sortDir('status') }) %>">Status<%= sortIndicator('status') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'createdAt', dir: sortDir('createdAt') }) %>">Created<%= sortIndicator('createdAt') %></a></th>
          <th class="px-4 py-3 text-right font-semibold text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% data.items.forEach(p => { %>
          <tr>
            <td class="px-4 py-3"><input class="row-check" type="checkbox" name="ids" value="<%= p.id %>" /></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= p.title %></td>
            <td class="px-4 py-3 text-slate-600"><%= p.category %><%= p.subCategory ? ' / ' + p.subCategory : '' %></td>
            <td class="px-4 py-3 text-slate-600">₹<%= p.price %> <span class="text-xs text-slate-400"><%= p.priceUnit %></span></td>
            <td class="px-4 py-3 text-slate-600">
              <div><%= p.mobile || '—' %></div>
              <div class="text-xs text-slate-400"><%= p.location || '' %></div>
            </td>
            <td class="px-4 py-3">
              <% const badge = { pending: 'bg-amber-50 text-amber-700', active: 'bg-emerald-50 text-emerald-700', expired: 'bg-slate-100 text-slate-600', rejected: 'bg-red-50 text-red-700', deleted: 'bg-red-100 text-red-800' } %>
              <span class="rounded-full <%= badge[p.status] || 'bg-slate-100 text-slate-600' %> px-2.5 py-1 text-xs font-semibold"><%= p.status %></span>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= new Date(p.createdAt).toLocaleDateString() %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap justify-end gap-1.5">
                <a href="/admin/products/<%= p.id %>/edit" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">Edit</a>
                <% if (p.status === 'pending' || p.status === 'rejected') { %>
                  <button type="submit" form="activate-<%= p.id %>" class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100">Approve</button>
                <% } %>
                <% if (p.status === 'pending') { %>
                  <button type="submit" form="reject-<%= p.id %>" class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:bg-amber-100">Reject</button>
                <% } %>
                <button type="submit" form="delete-<%= p.id %>" onclick="return confirm('Delete this listing?')" class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Delete</button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (data.items.length === 0) { %>
          <tr><td colspan="8" class="px-4 py-10 text-center text-slate-400">No listings found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<% data.items.forEach(p => { %>
  <form id="activate-<%= p.id %>" method="post" action="/admin/products/<%= p.id %>/activate" class="hidden"></form>
  <form id="reject-<%= p.id %>" method="post" action="/admin/products/<%= p.id %>/reject" class="hidden"></form>
  <form id="delete-<%= p.id %>" method="post" action="/admin/products/<%= p.id %>/delete" class="hidden"></form>
<% }) %>

<% if (data.total > data.limit) { %>
  <div class="mt-4 flex justify-center gap-2 text-sm">
    <% for (let p = 1; p <= data.pages; p++) { %>
      <a href="?<%= qs({ page: p }) %>"
        class="rounded-lg px-3 py-1.5 <%= p === data.page ? 'bg-emerald-600 text-white' : 'border border-slate-200 text-slate-600 hover:bg-slate-50' %>"><%= p %></a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
