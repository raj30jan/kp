<%- include('../partials/head') %>
<% const currentQuery = { status: statusFilter, q, sort, dir, page: data.page } %>
<%
function qs(overrides) {
  const merged = Object.assign({}, typeof currentQuery !== 'undefined' ? currentQuery : {}, overrides)
  return Object.entries(merged)
    .filter(([, v]) => v !== '' && v !== undefined && v !== null)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&')
}
function sortDir(col) {
  return (typeof sort !== 'undefined' && sort === col && dir === 'ASC') ? 'DESC' : 'ASC'
}
function sortIndicator(col) {
  if (typeof sort === 'undefined' || sort !== col) return ''
  return dir === 'ASC' ? ' ▲' : ' ▼'
}
%>

<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
  <form method="get" action="/admin/leads" class="flex flex-wrap items-center gap-2">
    <input type="text" name="q" value="<%= q %>" placeholder="Search service, mobile, source page…"
      class="h-10 w-64 rounded-lg border border-slate-300 px-3 text-sm" />
    <select name="status" onchange="this.form.submit()" class="h-10 rounded-lg border border-slate-300 px-3 text-sm">
      <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All statuses</option>
      <option value="PENDING" <%= statusFilter === 'PENDING' ? 'selected' : '' %>>Pending</option>
      <option value="CONTACTED" <%= statusFilter === 'CONTACTED' ? 'selected' : '' %>>Contacted</option>
      <option value="GUIDED" <%= statusFilter === 'GUIDED' ? 'selected' : '' %>>Guided</option>
      <option value="CLOSED" <%= statusFilter === 'CLOSED' ? 'selected' : '' %>>Closed</option>
    </select>
    <button class="h-10 rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700">Search</button>
  </form>
  <div class="flex items-center gap-3">
    <p class="text-sm text-slate-500"><%= data.total %> total leads</p>
    <a href="/admin/leads/new" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">+ Log Lead</a>
  </div>
</div>

<form method="post" action="/admin/leads/bulk" id="bulk-form">
  <div class="mb-3 flex items-center gap-2">
    <button type="submit" onclick="return confirm('Delete all selected leads? This cannot be undone.')"
      class="h-9 rounded-lg border border-red-200 bg-red-50 px-3 text-sm font-semibold text-red-700 hover:bg-red-100">Delete Selected</button>
  </div>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-slate-100">
    <table class="min-w-full divide-y divide-slate-100 text-sm">
      <thead class="bg-slate-50">
        <tr>
          <th class="px-4 py-3"><input type="checkbox" onclick="document.querySelectorAll('.row-check').forEach(c=>c.checked=this.checked)" /></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'serviceName', dir: sortDir('serviceName') }) %>">Service<%= sortIndicator('serviceName') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Mobile</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500">Source Page</th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'contactStatus', dir: sortDir('contactStatus') }) %>">Status<%= sortIndicator('contactStatus') %></a></th>
          <th class="px-4 py-3 text-left font-semibold text-slate-500"><a href="?<%= qs({ sort: 'createdAt', dir: sortDir('createdAt') }) %>">Captured<%= sortIndicator('createdAt') %></a></th>
          <th class="px-4 py-3 text-right font-semibold text-slate-500">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% data.items.forEach(l => { %>
          <tr>
            <td class="px-4 py-3"><input class="row-check" type="checkbox" name="ids" value="<%= l.id %>" /></td>
            <td class="px-4 py-3 font-medium text-slate-800"><%= l.serviceName %></td>
            <td class="px-4 py-3 text-slate-600"><%= l.mobile || '—' %></td>
            <td class="px-4 py-3 text-slate-600"><%= l.sourcePage || '—' %></td>
            <td class="px-4 py-3">
              <% const badge = { PENDING: 'bg-amber-50 text-amber-700', CONTACTED: 'bg-blue-50 text-blue-700', GUIDED: 'bg-indigo-50 text-indigo-700', CLOSED: 'bg-emerald-50 text-emerald-700' } %>
              <span class="rounded-full <%= badge[l.contactStatus] || 'bg-slate-100 text-slate-600' %> px-2.5 py-1 text-xs font-semibold"><%= l.contactStatus %></span>
            </td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= new Date(l.createdAt).toLocaleDateString() %></td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap justify-end gap-1.5">
                <button type="button" onclick="document.getElementById('status-modal-<%= l.id %>').classList.remove('hidden')"
                  class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100">Update Status</button>
                <button type="submit" form="delete-<%= l.id %>" onclick="return confirm('Delete this lead?')" class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-100">Delete</button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (data.items.length === 0) { %>
          <tr><td colspan="7" class="px-4 py-10 text-center text-slate-400">No leads found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<% data.items.forEach(l => { %>
  <form id="delete-<%= l.id %>" method="post" action="/admin/leads/<%= l.id %>/delete" class="hidden"></form>

  <div id="status-modal-<%= l.id %>" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-md rounded-2xl bg-white p-5 shadow-xl">
      <h3 class="mb-3 text-sm font-bold text-slate-800">Update status — <%= l.serviceName %></h3>
      <form method="post" action="/admin/leads/<%= l.id %>/status" class="space-y-3">
        <select name="contactStatus" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
          <% ['PENDING','CONTACTED','GUIDED','CLOSED'].forEach(s => { %>
            <option value="<%= s %>" <%= l.contactStatus === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <textarea name="notes" rows="3" placeholder="Notes"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><%= l.notes || '' %></textarea>
        <div class="flex justify-end gap-2">
          <button type="button" onclick="document.getElementById('status-modal-<%= l.id %>').classList.add('hidden')"
            class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
          <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700">Save</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>

<% if (data.total > data.limit) { %>
  <div class="mt-4 flex justify-center gap-2 text-sm">
    <% for (let p = 1; p <= data.pages; p++) { %>
      <a href="?<%= qs({ page: p }) %>"
        class="rounded-lg px-3 py-1.5 <%= p === data.page ? 'bg-emerald-600 text-white' : 'border border-slate-200 text-slate-600 hover:bg-slate-50' %>"><%= p %></a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/foot') %>
