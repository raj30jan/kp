<%- include('../partials/head') %>

<div class="mx-auto max-w-xl rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100">
  <p class="mb-4 text-sm text-slate-500">Log a walk-in / phone enquiry manually.</p>
  <% if (errors) { %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= errors %></div>
  <% } %>

  <form method="post" action="/admin/leads/new" class="space-y-4">
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Service Code</label>
      <input name="serviceCode" required value="<%= (lead && lead.serviceCode) || '' %>" placeholder="HIRE_MACHINERY"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Service Name</label>
      <input name="serviceName" required value="<%= (lead && lead.serviceName) || '' %>" placeholder="Hire Machinery — JCB, Tractor"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700">Mobile</label>
      <input name="mobile" value="<%= (lead && lead.mobile) || '' %>" placeholder="9876543210"
        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Log Lead</button>
      <a href="/admin/leads" class="text-sm font-medium text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>
