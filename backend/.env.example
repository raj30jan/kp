# Application
NODE_ENV=development
PORT=4000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=kisan
MYSQL_PASSWORD=Kisan@123
MYSQL_DATABASE=kisanpatrika

# MongoDB (set MONGO_ENABLED=true once mongod is installed and running)
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/kisanpatrika

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# OTP (dev mode returns OTP in API response; prod sends SMS)
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
# Email OTP as a second factor after password login (website + admin panel).
# Keep true in production. With OTP_DEV_MODE=true the OTP is also returned in the API response.
LOGIN_OTP_REQUIRED=true

# Email (SMTP relay — sends OTP to email)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@yourdomain.com
INFO_EMAIL=info@yourdomain.com

# Social login
# Google: create an OAuth 2.0 Client ID (Web application) in Google Cloud
# Console. The frontend uses the same Client ID for Google Identity Services
# sign-in; the backend verifies the resulting ID token against it.
GOOGLE_CLIENT_ID=

# Facebook: access tokens from the Facebook Login SDK are verified directly
# against the Graph API, so no server-side secret is required here.

# SMS gateway (fallback notification channel when a user has no email).
# Not integrated yet — see src/common/sms.service.ts. Set SMS_API_KEY once an
# MSG91/Twilio account is provisioned.
SMS_API_KEY=
